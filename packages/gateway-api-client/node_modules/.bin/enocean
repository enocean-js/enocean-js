#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/holger/enocean-js/packages/gateway/node_modules:/home/holger/enocean-js/packages/node_modules:/home/holger/enocean-js/node_modules:/home/holger/node_modules:/home/node_modules:/node_modules:/home/holger/enocean-js/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/holger/enocean-js/packages/gateway/node_modules:/home/holger/enocean-js/packages/node_modules:/home/holger/enocean-js/node_modules:/home/holger/node_modules:/home/node_modules:/node_modules:/home/holger/enocean-js/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@enocean-js/gateway/index.js" "$@"
else
  exec node  "$basedir/../@enocean-js/gateway/index.js" "$@"
fi
